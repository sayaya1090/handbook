{
  "context-loader": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./.agents/hooks/context-loader.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "route-checkpoint-reminder": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/hooks/route-checkpoint-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "block-gwt-cache": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/hooks/block-gwt-cache.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "detect-korean-hardcode": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/hooks/detect-korean-hardcode.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
